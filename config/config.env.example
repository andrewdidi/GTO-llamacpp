# GTO llama.cpp Pod 配置（复制为 config.env 后按需修改）
# RunPod / Docker 也可用同名环境变量覆盖。

API_KEY=sk-gto-REPLACE_ME
HOST=0.0.0.0
PORT=8000

# --- 挂载盘 ---
VOLUME_ROOT=/models

# --- 推荐：直接下现成 GGUF（约 5–6GB，避免本地转换撑盘）---
HF_TOKEN=hf_REPLACE_ME
HF_GGUF_REPO=unsloth/Qwen3.5-9B-GGUF
HF_GGUF_FILE=Qwen3.5-9B-Q4_K_M.gguf
MODEL_PATH=/models/gguf/Qwen3.5-9B-Q4_K_M.gguf
MODEL_ALIAS=Qwen3.5-9B
MODEL_URL=
AUTO_CONVERT=0

# --- 仅当 AUTO_CONVERT=1 时才下载官方 Safetensors 并转换（需≥25GB 空闲）---
HF_REPO_ID=Qwen/Qwen3.5-9B
HF_LOCAL_DIR=/models/hf/Qwen3.5-9B
HF_DOWNLOAD_REVISION=
HF_HUB_ENABLE_HF_TRANSFER=1
CONVERT_OUTTYPE=q8_0
QUANTIZE_TYPE=Q4_K_M
KEEP_CONVERT_TMP=0

N_GPU_LAYERS=999
CTX_SIZE=8192
THREADS=0
FLASH_ATTN=0
CONT_BATCHING=1
EXTRA_ARGS=

LLAMA_SERVER_BIN=/app/llama-server
CONVERT_SCRIPT=/app/convert_hf_to_gguf.py
LLAMA_QUANTIZE_BIN=/app/llama-quantize
