# GTO llama.cpp Pod 配置（复制为 config.env 后按需修改）
# RunPod / Docker 也可用同名环境变量覆盖。

# --- 必填：API Key（客户端 Authorization: Bearer <API_KEY>）---
API_KEY=sk-gto-REPLACE_ME

# --- 监听（RunPod HTTP 代理必须 0.0.0.0:8000）---
HOST=0.0.0.0
PORT=8000

# --- 挂载盘根目录（RunPod Network Volume 请挂到这里）---
VOLUME_ROOT=/models
# 下面路径默认由 VOLUME_ROOT 推导，一般不用改：
#   HF_LOCAL_DIR=$VOLUME_ROOT/hf/Qwen3.5-9B
#   MODEL_PATH=$VOLUME_ROOT/gguf/Qwen3.5-9B-Q4_K_M.gguf
#   CACHE_ROOT=$VOLUME_ROOT/cache   （tmp/torch/hf/pip 全在这）

# --- Hugging Face ---
HF_TOKEN=hf_REPLACE_ME
HF_REPO_ID=Qwen/Qwen3.5-9B
HF_LOCAL_DIR=/models/hf/Qwen3.5-9B
HF_DOWNLOAD_REVISION=
HF_HUB_ENABLE_HF_TRANSFER=1

# --- GGUF ---
MODEL_PATH=/models/gguf/Qwen3.5-9B-Q4_K_M.gguf
MODEL_ALIAS=Qwen3.5-9B
MODEL_URL=
AUTO_CONVERT=1
CONVERT_OUTTYPE=q8_0
QUANTIZE_TYPE=Q4_K_M
KEEP_CONVERT_TMP=0

# --- llama-server 性能 ---
N_GPU_LAYERS=999
CTX_SIZE=8192
THREADS=0
FLASH_ATTN=0
CONT_BATCHING=1
EXTRA_ARGS=

# --- 可执行文件 ---
LLAMA_SERVER_BIN=/app/llama-server
CONVERT_SCRIPT=/app/convert_hf_to_gguf.py
LLAMA_QUANTIZE_BIN=/app/llama-quantize
